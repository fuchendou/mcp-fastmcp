{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "apps/example_mcp/src/example_mcp/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": "3.12",
    "dependencies": [
      "fastmcp>=2,<3"
    ],
    "editable": "."
  },
  "deployment": {
    "transport": "http",
    "host": "0.0.0.0",
    "port": 8000,
    "path": "/mcp",
    "log_level": "INFO",
    "env": {
      "MCP_ENVIRONMENT": "development",
      "MCP_LOG_LEVEL": "INFO",
      "MCP_TRANSPORT": "http",
      "MCP_HOST": "0.0.0.0",
      "MCP_PORT": "8000",
      "MCP_PATH": "/mcp",
      "EXAMPLE_MCP_SERVER_NAME": "Example MCP",
      "EXAMPLE_MCP_GREETING": "Hello from FastMCP HTTP config",
      "EXAMPLE_MCP_OWNER": "platform-team"
    }
  }
}
